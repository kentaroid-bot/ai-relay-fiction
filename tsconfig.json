{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node", "@cloudflare/workers-types"]
  },
  "include": [
    "convex/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "worker/**/*.ts"
  ]
}
