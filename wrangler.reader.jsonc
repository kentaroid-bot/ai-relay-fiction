{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-relay-reader",
  "account_id": "a6172b74b60ff4494d43e6601de6fbbe",
  "main": "reader/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "secrets": { "required": ["READER_TOKEN"] },
  "ratelimits": [
    {
      "name": "READING_LIMIT",
      "namespace_id": "2026093001",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
